# Sử dụng chính xác phiên bản Java/Maven nền mà đồ án YAS đang dùng [cite: 4, 7]
FROM maven:3.9-eclipse-temurin-21

# Cập nhật và cài đặt Docker CLI (docker.io) để container agent có thể gọi Docker-in-Docker / DooD
RUN apt-get update && apt-get install -y docker.io && rm -rf /var/lib/apt/lists/*

# Tải cài đặt cứng kubectl phiên bản ổn định vào hệ thống bên trong Image
RUN curl -LO "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl" \
    && chmod +x ./kubectl \
    && mv ./kubectl /usr/local/bin/kubectl

# Kiểm tra xem kubectl và docker đã cài đặt thành công chưa lúc build
RUN kubectl version --client && docker --version
pipeline {
    agent {
        docker {
            image 'docker.io/anhhnus/maven-kubectl:3.9-21'
            args '-v /var/run/docker.sock:/var/run/docker.sock -v $HOME/.m2:/root/.m2 --network host --privileged --user root'
        }
    }
    
    parameters {
        string(name: 'DEVELOPER_NS', defaultValue: 'yas-dev', description: 'Namespace của developer muốn dọn dẹp / xóa bỏ trên K3s (vd: yas-dev)')
        booleanParam(name: 'DELETE_ENTIRE_NAMESPACE', defaultValue: false, description: 'Chọn TRUE nếu muốn xóa hoàn toàn Namespace. Nếu FALSE chỉ tắt toàn bộ pod (scale replicas = 0)')
    }
    
    stages {
        stage('Destroy / Cleanup Developer Workspace') {
            steps {
                script {
                    echo "=========================================================="
                    echo "[JOB DEVELOPER_DESTROY] Đang dọn dẹp tài nguyên cho: ${params.DEVELOPER_NS}"
                    echo "=========================================================="
                    
                    withCredentials([file(credentialsId: 'k3s-kubeconfig', variable: 'KUBE_CONFIG_PATH')]) {
                        sh 'curl -k https://100.118.54.48:6443/livez || true'
                        
                        // Kiểm tra nhanh và tự động tải về kubectl nếu trong agent chưa có
                        sh '''
                            if ! command -v kubectl > /dev/null 2>&1; then
                                echo "[WARNING] kubectl chưa có sẵn. Đang tự động tải về kubectl..."
                                curl -LO "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl"
                                chmod +x kubectl
                                mv kubectl /usr/local/bin/ || mv kubectl /usr/bin/
                            fi
                        '''
                        
                        if (params.DELETE_ENTIRE_NAMESPACE) {
                            echo "--> Xóa hoàn toàn namespace [${params.DEVELOPER_NS}]..."
                            sh "kubectl --kubeconfig=\${KUBE_CONFIG_PATH} --insecure-skip-tls-verify=true delete namespace ${params.DEVELOPER_NS} --ignore-not-found=true"
                        } else {
                            echo "--> Scale toàn bộ deployment trong namespace [${params.DEVELOPER_NS}] về 0 replicas..."
                            sh "kubectl --kubeconfig=\${KUBE_CONFIG_PATH} --insecure-skip-tls-verify=true scale deployment --all --replicas=0 -n ${params.DEVELOPER_NS} || true"
                        }
                    }
                }
            }
        }
    }
    
    post {
        always {
            echo "[SUCCESS] Đã giải phóng hoàn tất tài nguyên môi trường kiểm thử của developer: ${params.DEVELOPER_NS}"
        }
    }
}

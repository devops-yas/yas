pipeline {
    agent {
        docker {
            image 'maven:3.9-eclipse-temurin-21'
            args '-v /var/run/docker.sock:/var/run/docker.sock -v $HOME/.m2:/root/.m2 --network host --privileged --user root'
        }
    }
    
    options {
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }
    
    // Tham số đầu vào cho developer theo đúng Yêu cầu 4 của Đồ án
    parameters {
        string(name: 'DEVELOPER_NS', defaultValue: 'yas-dev', description: 'Namespace trên cụm K3s dành riêng cho developer kiểm thử (mặc định: yas-dev)')
        string(name: 'TAX_TAG', defaultValue: 'main', description: 'Tag image cho dịch vụ Tax (mặc định: main, điền tên branch/commit id nếu muốn test nhánh riêng vd: dev_tax_service)')
        string(name: 'ORDER_TAG', defaultValue: 'main', description: 'Tag image cho dịch vụ Order (mặc định: main)')
        string(name: 'CART_TAG', defaultValue: 'main', description: 'Tag image cho dịch vụ Cart (mặc định: main)')
        string(name: 'PRODUCT_TAG', defaultValue: 'main', description: 'Tag image cho dịch vụ Product (mặc định: main)')
        string(name: 'CUSTOMER_TAG', defaultValue: 'main', description: 'Tag image cho dịch vụ Customer (mặc định: main)')
        string(name: 'INVENTORY_TAG', defaultValue: 'main', description: 'Tag image cho dịch vụ Inventory (mặc định: main)')
        string(name: 'MEDIA_TAG', defaultValue: 'main', description: 'Tag image cho dịch vụ Media (mặc định: main)')
        string(name: 'PAYMENT_TAG', defaultValue: 'main', description: 'Tag image cho dịch vụ Payment (mặc định: main)')
        string(name: 'STOREFRONT_BFF_TAG', defaultValue: 'main', description: 'Tag image cho Storefront BFF (mặc định: main)')
        string(name: 'STOREFRONT_TAG', defaultValue: 'main', description: 'Tag image cho Storefront UI (mặc định: main)')
        string(name: 'BACKOFFICE_BFF_TAG', defaultValue: 'main', description: 'Tag image cho Backoffice BFF (mặc định: main)')
        string(name: 'BACKOFFICE_TAG', defaultValue: 'main', description: 'Tag image cho Backoffice UI (mặc định: main)')
        string(name: 'DEFAULT_ALL_OTHER_TAG', defaultValue: 'main', description: 'Tag mặc định cho tất cả các service khác không có parameter ở trên')
    }
    
    environment {
        REGISTRY_URL = 'docker.io'
        DOCKER_NAMESPACE = 'anhhnus'
    }
    
    stages {
        stage('Deploy to Developer Workspace (K3s)') {
            steps {
                script {
                    echo "=========================================================="
                    echo "[JOB DEVELOPER_BUILD] Khởi tạo triển khai cho Developer"
                    echo "Namespace đích: ${params.DEVELOPER_NS}"
                    echo "=========================================================="
                    
                    // Bản đồ ánh xạ service và tag tương ứng từ tham số
                    def serviceTagMap = [
                        'tax': params.TAX_TAG,
                        'order': params.ORDER_TAG,
                        'cart': params.CART_TAG,
                        'product': params.PRODUCT_TAG,
                        'customer': params.CUSTOMER_TAG,
                        'inventory': params.INVENTORY_TAG,
                        'media': params.MEDIA_TAG,
                        'payment': params.PAYMENT_TAG,
                        'storefront-bff': params.STOREFRONT_BFF_TAG,
                        'storefront-ui': params.STOREFRONT_TAG,
                        'backoffice-bff': params.BACKOFFICE_BFF_TAG,
                        'backoffice-ui': params.BACKOFFICE_TAG,
                        'location': params.DEFAULT_ALL_OTHER_TAG,
                        'promotion': params.DEFAULT_ALL_OTHER_TAG,
                        'rating': params.DEFAULT_ALL_OTHER_TAG,
                        'search': params.DEFAULT_ALL_OTHER_TAG,
                        'recommendation': params.DEFAULT_ALL_OTHER_TAG,
                        'sampledata': params.DEFAULT_ALL_OTHER_TAG,
                        'webhook': params.DEFAULT_ALL_OTHER_TAG
                    ]
                    
                    withCredentials([file(credentialsId: 'k3s-kubeconfig', variable: 'KUBE_CONFIG_PATH')]) {
                        sh 'curl -k https://100.118.54.48:6443/livez || true'
                        
                        // 1. Đảm bảo namespace tồn tại
                        sh "kubectl --kubeconfig=\${KUBE_CONFIG_PATH} --insecure-skip-tls-verify=true create namespace ${params.DEVELOPER_NS} --dry-run=client -o yaml | kubectl --kubeconfig=\${KUBE_CONFIG_PATH} --insecure-skip-tls-verify=true apply -f -"
                        
                        // 2. Cập nhật image cho từng service
                        serviceTagMap.each { serviceName, tagValue ->
                            def imageRepo = "${env.REGISTRY_URL}/${env.DOCKER_NAMESPACE}/${serviceName}:${tagValue}"
                            echo "--> Deploying [${serviceName}] với Image: ${imageRepo} vào Namespace [${params.DEVELOPER_NS}]"
                            
                            // Thực thi cập nhật image K8s (nếu deployment đã tồn tại)
                            sh """
                                kubectl --kubeconfig=\${KUBE_CONFIG_PATH} --insecure-skip-tls-verify=true \
                                set image deployment/${serviceName} \
                                ${serviceName}=${imageRepo} -n ${params.DEVELOPER_NS} || \
                                echo "[INFO] Deployment '${serviceName}' chưa có sẵn trong namespace '${params.DEVELOPER_NS}', bỏ qua set image."
                            """
                        }
                    }
                }
            }
        }
    }
    
    post {
        always {
            script {
                echo "========================================================================"
                echo " [SUCCESS] TRIỂN KHAI HOÀN TẤT CHO DEVELOPER (Namespace: ${params.DEVELOPER_NS})"
                echo "========================================================================"
                echo " 👉 HƯỚNG DẪN TRUY CẬP VÀ TEST CODE DÀNH CHO DEVELOPER:"
                echo " 1. Mở file hosts trên máy tính cá nhân của bạn:"
                echo "    - Windows: C:\\Windows\\System32\\drivers\\etc\\hosts"
                echo "    - Linux/Mac: /etc/hosts"
                echo " 2. Thêm dòng sau vào file hosts (trỏ đến IP Worker Node K8s):"
                echo "    <IP_Worker_Node>  api.yas.local storefront.yas.local backoffice.yas.local"
                echo " 3. Truy cập thông qua trình duyệt hoặc Postman/Curl với NodePort:"
                echo "    http://storefront.yas.local:<NodePort>/"
                echo "    http://api.yas.local:<NodePort>/swagger-ui.html"
                echo "========================================================================"
            }
        }
    }
}
